# SxrveshLabs Runner — Environment Configuration
# Copy this file to .env.local for local frontend development.
# WARNING: Never commit real credentials or secrets to version control.

# --- Supabase Configuration (Client & Backend) ---
# Supabase Project URL (Client-safe)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Public Anon Key (Client-safe, subject to PostgreSQL RLS policies)
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase Service Role Key (SERVER-SIDE ONLY — Cloudflare Worker / Backend API)
# NEVER prefix with VITE_ or expose to the frontend client.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# --- Cloudflare Configuration ---
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id"
CLOUDFLARE_API_TOKEN="your_cloudflare_api_token"
CLOUDFLARE_PROJECT_NAME="sxrveshlabs-runner"

# --- Runner & Licensing Cryptography ---
# Secret used for signing short-lived execution tokens and script download authorizations
RUNNER_SIGNING_SECRET="replace-with-a-cryptographically-secure-random-string-at-least-32-chars"

# --- Application Host URLs ---
APP_URL="http://localhost:3000"

# --- Gemini API (Optional System Integration) ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"
